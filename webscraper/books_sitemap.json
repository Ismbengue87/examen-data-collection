{
  "_id": "books_raw",
  "startUrl": ["https://books.toscrape.com/catalogue/page-[1-50].html"],
  "selectors": [
    {
      "id": "livre",
      "parentSelectors": ["_root"],
      "type": "SelectorLink",
      "selector": "article.product_pod h3 a",
      "multiple": true,
      "linkType": "linkFromHref"
    },
    {
      "id": "titre",
      "parentSelectors": ["livre"],
      "type": "SelectorText",
      "selector": "h1",
      "multiple": false,
      "regex": ""
    },
    {
      "id": "prix",
      "parentSelectors": ["livre"],
      "type": "SelectorText",
      "selector": "p.price_color",
      "multiple": false,
      "regex": ""
    },
    {
      "id": "disponibilite",
      "parentSelectors": ["livre"],
      "type": "SelectorText",
      "selector": "p.instock.availability",
      "multiple": false,
      "regex": ""
    },
    {
      "id": "note",
      "parentSelectors": ["livre"],
      "type": "SelectorElementAttribute",
      "selector": "p.star-rating",
      "multiple": false,
      "extractAttribute": "class"
    },
    {
      "id": "description",
      "parentSelectors": ["livre"],
      "type": "SelectorText",
      "selector": "#product_description ~ p",
      "multiple": false,
      "regex": ""
    },
    {
      "id": "categorie",
      "parentSelectors": ["livre"],
      "type": "SelectorText",
      "selector": "ul.breadcrumb li:nth-of-type(3) a",
      "multiple": false,
      "regex": ""
    },
    {
      "id": "upc",
      "parentSelectors": ["livre"],
      "type": "SelectorText",
      "selector": "table.table-striped tr:nth-of-type(1) td",
      "multiple": false,
      "regex": ""
    },
    {
      "id": "type_produit",
      "parentSelectors": ["livre"],
      "type": "SelectorText",
      "selector": "table.table-striped tr:nth-of-type(2) td",
      "multiple": false,
      "regex": ""
    },
    {
      "id": "tax",
      "parentSelectors": ["livre"],
      "type": "SelectorText",
      "selector": "table.table-striped tr:nth-of-type(5) td",
      "multiple": false,
      "regex": ""
    },
    {
      "id": "nombre_reviews",
      "parentSelectors": ["livre"],
      "type": "SelectorText",
      "selector": "table.table-striped tr:nth-of-type(7) td",
      "multiple": false,
      "regex": ""
    }
  ]
}
